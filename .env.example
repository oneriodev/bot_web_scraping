# Modelo de configuração. Copie para .env e ajuste:  cp .env.example .env
# O .env real NUNCA vai para o GitHub (está no .gitignore). Este arquivo, sem segredos, vai.

# Pasta onde ficam arquivos baixados, caixa de entrada manual e (na Etapa 2) o banco DuckDB
DATA_DIR=data
LOG_DIR=logs
LOG_LEVEL=INFO

# Coleta responsável: robots.txt + 1 coleta/dia + pausa entre requisições ao mesmo site.
# USER_AGENT vazio/ausente = padrão do requests (não identifica quem coleta).
# USER_AGENT=
REQUEST_TIMEOUT_SECONDS=15
REQUEST_DELAY_SECONDS=2.0
MAX_RETRIES=3

# Chaves de API (Etapa 4) — preencha só no .env, nunca aqui
# Chave em https://aistudio.google.com — preencha SÓ no .env, nunca aqui
GEMINI_API_KEY=
# Confira no AI Studio o nome do modelo Flash mais recente
GEMINI_MODEL=gemini-3.8-flash
# Pausa entre chamadas (respeita o limite de requisições por minuto do plano gratuito)
LLM_DELAY_SECONDS=4
# Abaixo desta confiança, a oferta vai para revisão humana
EXTRACTION_MIN_CONFIDENCE=0.8
# Teto de imagens por execução (controle de custo)
EXTRACTION_MAX_PER_RUN=20
# ANTHROPIC_API_KEY=


# Fuso da operação: define o que é "hoje" ao comparar com a validade das ofertas
TIMEZONE=America/Cuiaba